# ── Telegram ─────────────────────────────────────────────────────────────────
BOT_TOKEN=123456:AA...
# Через запятую. Клиент + разработчик.
ADMIN_IDS=564871314,2042819654

# Закрытая группа клуба (этап 3).
CLUB_CHAT_ID=-1003546154644
CLUB_CHAT_INVITE_URL=https://t.me/+xxxxxxxx
# Ссылка на поддержку (fallback; обычно из админки).
SUPPORT_URL=

# ── База данных ──────────────────────────────────────────────────────────────
# Локально бот ходит в уже запущенный на ПК postgres16, БД mydb.
# В docker-compose.dev.yml это переопределяется на host.docker.internal.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb
# Отдельная схема — база не пустая, чужие таблицы не трогаем.
DB_SCHEMA=maria_doll

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/3

# ── Продамус (этап 2) ────────────────────────────────────────────────────────
PRODAMUS_FORM_URL=https://dolbikfit.payform.ru
# Секретный ключ платёжной страницы (ЛК Продамуса → Настройки). Без него вебхук
# отклоняется, а ссылка идёт без подписи. Реальное значение — в .secrets/, не в git.
PRODAMUS_SECRET_KEY=
PRODAMUS_RETURN_URL=
# Демо-режим оплаты: true — в ссылку добавляется demo_mode=1 (тестовые платежи
# без реального списания). На бою — false.
PRODAMUS_DEMO_MODE=false
PRODAMUS_RECURRENT_ENABLED=false
# Приёмник вебхука. Путь укажите в ЛК Продамуса как «URL для уведомлений»
# (на проде: https://dolbikfit.ru/prodamus/webhook, за nginx на этот порт).
PRODAMUS_WEBHOOK_PORT=8080
PRODAMUS_WEBHOOK_PATH=/prodamus/webhook
EXPIRY_CHECK_INTERVAL_MIN=30

# ── Напоминания (этап 4) ─────────────────────────────────────────────────────
REMINDER_CHECK_INTERVAL_MIN=60
REMINDER_UNIT=day
REMINDER_EARLY_OFFSET=3
REMINDER_SOON_OFFSET=1
REMINDER_LAST_OFFSET=0

# ── Веб-админка (этап 6) ─────────────────────────────────────────────────────
ADMIN_WEB_SECRET=dev-insecure-change-me
ADMIN_WEB_LOGIN=admin
ADMIN_WEB_PASSWORD=

LOG_LEVEL=INFO
